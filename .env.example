SCIDOC_ENVIRONMENT=local
SCIDOC_DATABASE_URL=postgresql+psycopg://scidoc:scidoc@localhost:5432/scidoc
SCIDOC_REDIS_URL=redis://localhost:6379/0
SCIDOC_STORAGE_ROOT=./data
SCIDOC_QUEUE_MODE=dramatiq
SCIDOC_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SCIDOC_MAX_UPLOAD_MB=250
SCIDOC_LOG_LEVEL=INFO
SCIDOC_ENABLE_TABLES=true
SCIDOC_ENABLE_CHEMISTRY=true
SCIDOC_ENABLE_DIAGRAMS=true
SCIDOC_ENABLE_CHARTS=true
SCIDOC_ENABLE_VLM=true
# Natural narration uses the offline Kokoro model by default, then macOS Speech as a fallback.
SCIDOC_NARRATION_PROVIDER=auto
SCIDOC_NARRATION_LOCAL_MODEL=./data/models/narration/kokoro-v1.0.onnx
SCIDOC_NARRATION_LOCAL_VOICES=./data/models/narration/voices-v1.0.bin
SCIDOC_NARRATION_LOCAL_DEFAULT_VOICE=af_heart
# Optional OpenAI override. Keep this secret on the API server; never expose it as NEXT_PUBLIC_*.
OPENAI_API_KEY=
SCIDOC_NARRATION_MODEL=gpt-4o-mini-tts
SCIDOC_NARRATION_DEFAULT_VOICE=marin
NEXT_PUBLIC_API_URL=http://localhost:8000
